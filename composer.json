{
    "name": "conquer/oauth2",
    "description": "The Oauth2 Server extension for the Yii2 framework",
    "keywords": [
        "yii2",
        "oauth2",
        "oauth2-server"
    ],
    "homepage": "https://github.com/borodulin/yii2-oauth2-server",
    "type": "yii2-extension",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/borodulin/yii2-oauth2-server/issues",
        "source": "https://github.com/borodulin/yii2-oauth2-server"
    },
    "authors": [
        {
            "name": "Andrey Borodulin",
            "email": "borodulin@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^7.4 || ^8.0",
        "yiisoft/yii2": "^2.0",
        "jakeasmith/http_build_url": ">=1.0.1"
    },
    "require-dev": {
        "codeception/codeception": "^4.2 || ^5.0",
        "codeception/module-asserts": "^2.0 || ^3.0",
        "yiisoft/yii2-coding-standards": "^2.0",
        "ext-pdo_sqlite": "*"
    },
    "autoload": {
        "psr-4": {
            "conquer\\oauth2\\": "src"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0.x-dev"
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests/_support/",
            "tests\\unit\\": "tests/unit/"
        }
    }
}
